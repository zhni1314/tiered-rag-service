# ---- LLM (any OpenAI-compatible endpoint works) --------------------------
QWEN_API_KEY=sk-replace-me
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- Embedding / reranker models -----------------------------------------
TIERED_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TIERED_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Where model weights are cached. Leave empty to use the default HF cache.
HF_HOME=
# Use the mirror if huggingface.co is unreachable from your network.
HF_ENDPOINT=https://huggingface.co

# ---- Storage --------------------------------------------------------------
TIERED_RAG_CHROMA_DIR=data/chroma_db
TIERED_RAG_CHROMA_COLLECTION=rag_collection_v3
TIERED_RAG_UPLOAD_DIR=data/pdfs
TIERED_RAG_REDIS_URL=redis://localhost:6379/0
# Parent chunks live outside Chroma; default sits inside the Chroma dir so a
# --reset rebuild wipes both together.
TIERED_RAG_PARENT_STORE=

# ---- Retrieval tuning -----------------------------------------------------
# Ordered permission tiers; a user at tier N reads tiers 0..N.
TIERED_RAG_LEVELS=public,secret
TIERED_RAG_BM25_WEIGHT=0.5
TIERED_RAG_VECTOR_WEIGHT=0.5
TIERED_RAG_RETRIEVE_K=20
# Rerank more children than the parent cap: several children can share one parent.
TIERED_RAG_RERANK_TOP_N=10

# ---- Chunking -------------------------------------------------------------
# Parents (chunk_size) are what the LLM reads; children (child_chunk_size) are
# what gets embedded and keyword-indexed.
TIERED_RAG_CHUNK_SIZE=800
TIERED_RAG_CHUNK_OVERLAP=20
TIERED_RAG_CHILD_CHUNK_SIZE=200
TIERED_RAG_CHILD_CHUNK_OVERLAP=20
TIERED_RAG_CHUNK_SEPARATORS=
TIERED_RAG_MAX_PARENTS=3
TIERED_RAG_CONTEXT_BUDGET=3200

# ---- Text cleaning --------------------------------------------------------
# Repeated page layout that pollutes chunks. Set these to your own document's
# running header / footer, e.g. "<学院名>\s+<院系名>\s+v\d+\.\d+\s*版\s*"
TIERED_RAG_HEADER_PATTERN=
TIERED_RAG_FOOTER_PATTERN=
# Join Chinese sentences that were split across wrapped lines (no space in CJK).
TIERED_RAG_DROP_CJK_BREAKS=true

# ---- Conversation ---------------------------------------------------------
TIERED_RAG_HISTORY_WINDOW=10
